[project]
title = proto-blobs

[bootstrap]
main_collection = /main/main.collectionc

[input]
game_binding = /builtins/input/all.input_bindingc

[display]
width = 844
height = 390
high_dpi = 1

[script]
shared_state = 1

[mesh]
max_count = 512

[html5]
scale_mode = stretch
show_fullscreen_button = 0
show_made_with_defold = 0
heap_size = 256

[render]
clear_color_red = 0.62
clear_color_green = 0.84
clear_color_blue = 0.95
clear_color_alpha = 1.0
