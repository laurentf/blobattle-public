local ui = require "main.ui"
local gen = require "shared.sim.terrain_gen"
local gridbench = require "shared.sim.gridbench"

local RGBA = hash("rgba")
local DECL = { { name = RGBA, type = buffer.VALUE_TYPE_UINT8, count = 4 } }
local RADIUS = 40
local TOUCH = hash("touch")
local floor, sqrt, max, min = math.floor, math.sqrt, math.max, math.min

local wall = socket.gettime
local clock = socket.gettime

local function granularity(f)
	local best = 1
	for _ = 1, 5 do
		local a = f()
		local b = f()
		local n = 0
		while b == a and n < 2000000 do
			b = f()
			n = n + 1
		end
		if b > a and b - a < best then best = b - a end
	end
	return best
end

local function stats(list)
	local n = #list
	if n == 0 then return { n = 0 } end
	local s = {}
	local sum = 0
	for i = 1, n do
		s[i] = list[i]
		sum = sum + list[i]
	end
	table.sort(s)
	local function r(v) return floor(v * 1000 + 0.5) / 1000 end
	return { n = n, avg = r(sum / n), p50 = r(s[floor((n + 1) / 2)]), p95 = r(s[min(n, floor(n * 0.95 + 0.5))]), max = r(s[n]) }
end

local function build(self)
	local W, H = self.W, self.H
	local t0 = clock()
	local heights = gen.heights(W, H, gridbench.SEED)
	self.heights = heights
	if not self.buf then
		self.buf = buffer.create(W * H, DECL)
		self.stream = buffer.get_stream(self.buf, RGBA)
		self.zero = buffer.create(W, DECL)
		self.zstream = buffer.get_stream(self.zero, RGBA)
	else
		for y = 0, H - 1 do
			buffer.copy_stream(self.stream, y * W * 4, self.zstream, 0, W * 4)
		end
	end
	local st = self.stream
	local src = buffer.create(W * 2, DECL)
	local ss = buffer.get_stream(src, RGBA)
	local s = 1
	for i = 0, W * 2 - 1 do
		s = (s * 48271) % 2147483647
		local n = s % 28
		local b = i * 4
		ss[b + 1] = 105 + n
		ss[b + 2] = 70 + n
		ss[b + 3] = 38 + floor(n / 2)
		ss[b + 4] = 255
	end
	for y = 0, H - 1 do
		local off = (y * 131) % W
		local rowbase = y * W * 4
		local x = 0
		while x < W do
			if heights[x] > y then
				local x0 = x
				x = x + 1
				while x < W and heights[x] > y do x = x + 1 end
				buffer.copy_stream(st, rowbase + x0 * 4, ss, (off + x0) * 4, (x - x0) * 4)
			else
				x = x + 1
			end
		end
	end
	for x = 0, W - 1 do
		local hh = heights[x]
		for y = max(0, hh - 8), hh - 1 do
			local i = (y * W + x) * 4
			st[i + 1] = 70
			st[i + 2] = 175
			st[i + 3] = 55
		end
	end
	local t1 = clock()
	local targs = { type = graphics.TEXTURE_TYPE_2D, width = W, height = H, format = graphics.TEXTURE_FORMAT_RGBA }
	if not self.tex then
		self.tex = resource.create_texture("/spike_terrain_" .. W .. ".texturec", targs, self.buf)
		go.set("#mesh", "texture0", self.tex)
	else
		resource.set_texture(self.tex, targs, self.buf)
	end
	local t2 = clock()
	self.gen_ms = (t1 - t0) * 1000
	self.create_tex_ms = (t2 - t1) * 1000
	local hx = floor(W / 2)
	self.sanity = string.format("px(%d,%d)a=%d px(%d,%d)a=%d", hx, heights[hx] - 20, st[((heights[hx] - 20) * W + hx) * 4 + 4], hx, heights[hx] + 5, st[((heights[hx] + 5) * W + hx) * 4 + 4])
	local ok, info = pcall(graphics.get_adapter_info)
	self.max_tex = ok and info and info.limits and info.limits.max_texture_size_2d or -1
	self.adapter = ok and info and (tostring(info.family) .. " " .. tostring(info.version_major) .. "." .. tostring(info.version_minor)) or "?"
	ui.set("gen", string.format("map %dx%d gen %.0fms tex %.0fms | %s max_tex %d | clock-gran %.3fms", W, H, self.gen_ms, self.create_tex_ms, self.adapter, self.max_tex, self.gran * 1000))
end

local function carve_px(self, cx, cy, r)
	local W, H, st = self.W, self.H, self.stream
	local y0, y1 = max(0, cy - r), min(H - 1, cy + r)
	local xmin, xmax = W, -1
	local r2 = r * r
	for y = y0, y1 do
		local dy = y - cy
		local half = floor(sqrt(r2 - dy * dy))
		local xa, xb = max(0, cx - half), min(W - 1, cx + half)
		local base = y * W * 4 + 4
		for x = xa, xb do
			st[base + x * 4] = 0
		end
		if xa < xmin then xmin = xa end
		if xb > xmax then xmax = xb end
	end
	return xmin, y0, xmax, y1
end

local function carve_rows(self, cx, cy, r)
	local W, H, st, zs = self.W, self.H, self.stream, self.zstream
	local y0, y1 = max(0, cy - r), min(H - 1, cy + r)
	local xmin, xmax = W, -1
	local r2 = r * r
	for y = y0, y1 do
		local dy = y - cy
		local half = floor(sqrt(r2 - dy * dy))
		local xa, xb = max(0, cx - half), min(W - 1, cx + half)
		buffer.copy_stream(st, (y * W + xa) * 4, zs, 0, (xb - xa + 1) * 4)
		if xa < xmin then xmin = xa end
		if xb > xmax then xmax = xb end
	end
	return xmin, y0, xmax, y1
end

local function upload_full(self)
	resource.set_texture(self.tex, { type = graphics.TEXTURE_TYPE_2D, width = self.W, height = self.H, format = graphics.TEXTURE_FORMAT_RGBA }, self.buf)
end

local function upload_sub(self, x0, y0, x1, y1)
	local w, h = x1 - x0 + 1, y1 - y0 + 1
	local sb = buffer.create(w * h, DECL)
	local ss = buffer.get_stream(sb, RGBA)
	local W = self.W
	for row = 0, h - 1 do
		buffer.copy_stream(ss, row * w * 4, self.stream, ((y0 + row) * W + x0) * 4, w * 4)
	end
	resource.set_texture(self.tex, { type = graphics.TEXTURE_TYPE_2D, width = w, height = h, x = x0, y = y0, format = graphics.TEXTURE_FORMAT_RGBA }, sb)
end

local function crater(self, cx, cy, mode, carver)
	local t0 = clock()
	local x0, y0, x1, y1 = (carver or carve_px)(self, cx, cy, RADIUS)
	local t1 = clock()
	if mode == "full" then
		upload_full(self)
	else
		upload_sub(self, x0, y0, x1, y1)
	end
	local t2 = clock()
	return (t1 - t0) * 1000, (t2 - t1) * 1000
end

local function lookup_bench(self, n)
	local W, H, st = self.W, self.H, self.stream
	local s = 12345
	local t0 = clock()
	for _ = 1, n do
		s = (s * 48271) % 2147483647
		local x = s % W
		local y = (s * 7) % H
	end
	local t1 = clock()
	local solid = 0
	for _ = 1, n do
		s = (s * 48271) % 2147483647
		local x = s % W
		local y = (s * 7) % H
		if st[(y * W + x) * 4 + 4] > 0 then solid = solid + 1 end
	end
	local t2 = clock()
	local res = { buffer_ns = ((t2 - t1) - (t1 - t0)) * 1e9 / n }
	if W <= 2048 then
		local tb0 = clock()
		local tbl = {}
		local idx = 1
		for y = 0, H - 1 do
			local base = y * W * 4 + 4
			for x = 0, W - 1 do
				tbl[idx] = st[base + x * 4] > 0 and 1 or 0
				idx = idx + 1
			end
		end
		local tb1 = clock()
		res.table_build_ms = (tb1 - tb0) * 1000
		local t3 = clock()
		for _ = 1, n do
			s = (s * 48271) % 2147483647
			local x = s % W
			local y = (s * 7) % H
		end
		local t4 = clock()
		for _ = 1, n do
			s = (s * 48271) % 2147483647
			local x = s % W
			local y = (s * 7) % H
			if tbl[y * W + x + 1] == 1 then solid = solid + 1 end
		end
		local t5 = clock()
		res.table_ns = ((t5 - t4) - (t4 - t3)) * 1e9 / n
		res.lua_kb_with_table = collectgarbage("count")
		tbl = nil
		collectgarbage()
	end
	return res
end

local function start_bench(self, phases)
	self.bench = { phases = phases, pi = 1, k = 0, wait = 30, res = {}, cur = nil }
	self.craters = gen.craters(self.W, self.H, self.heights, gridbench.CRATER_SEED, gridbench.CRATERS, RADIUS)
end

local function finish_bench(self)
	local b = self.bench
	self.bench = nil
	local out = { platform = sys.get_sys_info().system_name, W = self.W, H = self.H, gen_ms = self.gen_ms, create_tex_ms = self.create_tex_ms, clock_gran_ms = self.gran * 1000, phases = b.res, sanity = self.sanity, max_tex = self.max_tex, adapter = self.adapter }
	local lk = lookup_bench(self, 200000)
	out.lookup = lk
	local g = gridbench.run(self.W, self.H, clock, 200000)
	out.grid = g
	out.lua_kb = collectgarbage("count")
	local txt = json.encode(out)
	ui.publish("spikeResults", txt)
	ui.set("bench", "bench done: see console / window.spikeResults")
	for _, ph in ipairs(b.phases) do
		local r = b.res[ph]
		if r then
			ui.set("bench_" .. ph, string.format("%-5s carve avg %.2f p95 %.2f | upload avg %.2f p95 %.2f | frame avg %.1f max %.1f (base %.1f)",
				ph, r.carve.avg or 0, r.carve.p95 or 0, r.upload.avg or 0, r.upload.p95 or 0, r.frame.avg or 0, r.frame.max or 0, b.res.baseline and b.res.baseline.frame.avg or 0))
		end
	end
	ui.set("lookup", string.format("lookup ns: buffer %.0f table %s grid %.0f | grid carve %.3fms", lk.buffer_ns, lk.table_ns and string.format("%.0f", lk.table_ns) or "-", g.lookup_ns, g.grid_carve_avg_ms))
	if self.exit_after then
		sys.exit(0)
	end
end

local function bench_step(self, frame_ms)
	local b = self.bench
	if b.wait > 0 then
		b.wait = b.wait - 1
		return
	end
	local ph = b.phases[b.pi]
	if not ph then
		finish_bench(self)
		return
	end
	if not b.cur then
		b.cur = { carve = {}, upload = {}, frame = {} }
		b.k = 0
		b.skip_frame = true
	end
	local cur = b.cur
	if b.skip_frame then
		b.skip_frame = false
	else
		cur.frame[#cur.frame + 1] = frame_ms
	end
	b.k = b.k + 1
	if ph == "baseline" then
		if b.k > 60 then
			b.res[ph] = { carve = stats(cur.carve), upload = stats(cur.upload), frame = stats(cur.frame) }
			b.cur = nil
			b.pi = b.pi + 1
			b.wait = 5
		end
		return
	end
	if b.k <= #self.craters then
		local c = self.craters[b.k]
		local mode = (ph == "full") and "full" or "sub"
		local carver = (ph == "rows") and carve_rows or carve_px
		local ct, ut = crater(self, c.x, c.y, mode, carver)
		cur.carve[#cur.carve + 1] = ct
		cur.upload[#cur.upload + 1] = ut
		ui.set("bench", string.format("bench %s %d/%d", ph, b.k, #self.craters))
	else
		b.res[ph] = { carve = stats(cur.carve), upload = stats(cur.upload), frame = stats(cur.frame) }
		b.cur = nil
		b.pi = b.pi + 1
		b.wait = 5
	end
end

function init(self)
	msg.post(".", "acquire_input_focus")
	ui.install()
	self.gran = granularity(socket.gettime)
	local gc = granularity(os.clock)
	if gc < self.gran then
		clock = os.clock
		self.gran = gc
	end
	self.W = tonumber(ui.param("size", "2048")) == 3072 and 3072 or 2048
	self.H = self.W / 2
	self.mode = "sub"
	go.set_scale(vmath.vector3(sys.get_config_int("display.width", 2048), sys.get_config_int("display.height", 1024), 1))
	build(self)
	self.frames = {}
	self.last = wall()
	self.n = 0
	ui.set("tap", "tap the ground to carve (mode " .. self.mode .. ")")
	if ui.param("bench", "0") == "1" then
		self.exit_after = not ui.is_html5
		start_bench(self, { "baseline", "sub", "full", "rows" })
	end
end

function update(self, dt)
	local t = wall()
	local frame_ms = (t - self.last) * 1000
	self.last = t
	self.n = self.n + 1
	self.frames[#self.frames + 1] = frame_ms
	if #self.frames >= 30 then
		local st = stats(self.frames)
		self.frames = {}
		ui.set("fps", string.format("frame avg %.1fms max %.1fms (%.0f fps) lua %.0f KB", st.avg, st.max, 1000 / st.avg, collectgarbage("count")))
	end
	if self.bench then
		bench_step(self, frame_ms)
	end
	if self.n % 10 == 0 then
		local c = ui.poll_cmd()
		if c then
			if c == "bench:sub" then
				start_bench(self, { "baseline", "sub", "rows" })
			elseif c == "bench:full" then
				start_bench(self, { "baseline", "full" })
			elseif c == "mode:sub" or c == "mode:full" then
				self.mode = c:sub(6)
				ui.set("tap", "tap the ground to carve (mode " .. self.mode .. ")")
			elseif c == "reset" then
				build(self)
			else
				msg.post("/net#net", "cmd", { cmd = c })
			end
		end
		ui.flush()
	end
end

function on_input(self, action_id, action)
	if action_id == TOUCH and action.pressed and not self.bench then
		local ww, wh = window.get_size()
		local cx = floor(action.screen_x / ww * self.W)
		local cy = floor(action.screen_y / wh * self.H)
		local ct, ut = crater(self, cx, cy, self.mode)
		ui.set("tap", string.format("tap (%d,%d) mode %s: carve %.2fms upload %.2fms", cx, cy, self.mode, ct, ut))
	end
end
