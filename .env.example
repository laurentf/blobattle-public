# Copier en .env (ignoré par git), puis remplir : docs/heberger.md.

# Le propriétaire des fichiers que les conteneurs écrivent : la sortie de `id -u` et de `id -g`.
UID=1000
GID=1000

# Les clés du serveur : une valeur aléatoire chacune (`openssl rand -hex 32`).
# `make web` met aussi la clé serveur dans le build web : la refaire après l'avoir changée.
NAKAMA_SERVER_KEY=
NAKAMA_HTTP_KEY=
NAKAMA_SESSION_KEY=
NAKAMA_REFRESH_KEY=
NAKAMA_CONSOLE_PASSWORD=
NAKAMA_CONSOLE_SIGNING_KEY=

# nginx, qui sert le build : 127.0.0.1 derrière un tunnel ou un reverse proxy,
# 0.0.0.0 pour le servir directement en http.
WEB_BIND=127.0.0.1
WEB_PORT=5380

# Nakama, port 7550 : 0.0.0.0 quand la page est en http (le client le cherche sur ce port),
# 127.0.0.1 derrière un tunnel ou un reverse proxy.
NAKAMA_BIND=0.0.0.0

# Le nom du jeu pour le Caddy du dépôt (`make https`), par exemple jeu.example.org.
DOMAIN=
